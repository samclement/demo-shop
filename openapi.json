{
  "openapi": "3.1.0",
  "info": {
    "title": "demo-shop",
    "version": "0.1.0",
    "description": "Demo: the shop people open; a page that places orders in demo-orders and keeps its own purchase log"
  },
  "components": {
    "schemas": {
      "Hello": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "hello from demo-shop"
          },
          "service": {
            "type": "string"
          },
          "caller": {
            "$ref": "#/components/schemas/Caller"
          },
          "visits": {
            "type": "integer",
            "description": "How many times it was asked"
          },
          "event": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "type": {
                "type": "string"
              },
              "id": {
                "type": "string"
              }
            },
            "required": [
              "type",
              "id"
            ],
            "description": "The event this request published, if any"
          },
          "traceId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "message",
          "service",
          "caller",
          "event",
          "traceId"
        ]
      },
      "Caller": {
        "type": "object",
        "properties": {
          "type": {
            "type": "string",
            "enum": [
              "app",
              "user",
              "anonymous"
            ]
          },
          "id": {
            "type": [
              "string",
              "null"
            ]
          },
          "user": {
            "type": "string",
            "description": "For an app: the signed-in person it is calling for"
          }
        },
        "required": [
          "type",
          "id"
        ]
      },
      "Shop": {
        "type": "object",
        "properties": {
          "service": {
            "type": "string"
          },
          "caller": {
            "$ref": "#/components/schemas/Caller"
          },
          "items": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "What can be bought"
          },
          "latestOrders": {
            "type": [
              "array",
              "null"
            ],
            "items": {
              "$ref": "#/components/schemas/Order"
            },
            "description": "The newest five orders, from demo-orders; null if it could not be asked"
          },
          "yourPurchases": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/MyPurchase"
            },
            "description": "Your newest five purchases through this shop, from its own database"
          },
          "traceId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "service",
          "caller",
          "items",
          "latestOrders",
          "yourPurchases",
          "traceId"
        ]
      },
      "Order": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "item": {
            "type": "string",
            "example": "tea"
          },
          "quantity": {
            "type": "integer",
            "example": 2
          },
          "placedBy": {
            "type": "string",
            "example": "demo-shop"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "item",
          "quantity",
          "placedBy",
          "at"
        ]
      },
      "MyPurchase": {
        "type": "object",
        "properties": {
          "orderId": {
            "type": "string"
          },
          "item": {
            "type": "string"
          },
          "quantity": {
            "type": "integer"
          },
          "via": {
            "type": "string",
            "description": "Who placed it: the page (user), or the app that called the shop"
          },
          "at": {
            "type": "string"
          }
        },
        "required": [
          "orderId",
          "item",
          "quantity",
          "via",
          "at"
        ]
      },
      "Bought": {
        "type": "object",
        "properties": {
          "order": {
            "$ref": "#/components/schemas/Order"
          },
          "boughtBy": {
            "$ref": "#/components/schemas/Caller"
          },
          "traceId": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "required": [
          "order",
          "boughtBy",
          "traceId"
        ]
      },
      "Problem": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string"
          }
        },
        "required": [
          "error"
        ]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/hello": {
      "get": {
        "summary": "Say hello and name the caller",
        "responses": {
          "200": {
            "description": "A greeting",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Hello"
                }
              }
            }
          }
        }
      }
    },
    "/api/shop": {
      "get": {
        "summary": "The shop: what it sells, the latest orders and your purchases",
        "responses": {
          "200": {
            "description": "The shop",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Shop"
                }
              }
            }
          }
        }
      }
    },
    "/api/buy": {
      "post": {
        "summary": "Buy something: the shop places the order with demo-orders",
        "description": "Anyone who reaches the shop may buy: a signed-in person (the page), or an app granted a call to demo-shop. The order is placed in demo-orders by this app, with its own token, for the signed-in person. Send `item` and `quantity` as JSON or as query parameters.",
        "parameters": [
          {
            "schema": {
              "type": "string",
              "minLength": 1,
              "maxLength": 40,
              "default": "tea",
              "example": "tea"
            },
            "required": false,
            "name": "item",
            "in": "query"
          },
          {
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 1000,
              "default": 1,
              "example": 2
            },
            "required": false,
            "name": "quantity",
            "in": "query"
          }
        ],
        "requestBody": {
          "required": false,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "item": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 40,
                    "default": "tea",
                    "example": "tea"
                  },
                  "quantity": {
                    "type": "integer",
                    "minimum": 1,
                    "maximum": 1000,
                    "default": 1,
                    "example": 2
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "The order demo-orders stored",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Bought"
                }
              }
            }
          },
          "502": {
            "description": "demo-orders refused or could not be reached",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            }
          }
        }
      }
    }
  },
  "webhooks": {}
}
